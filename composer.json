{
    "name": "ufo-tech/mcp-bundle",
    "minimum-stability": "stable",
    "description": "Expose UFO JSON-RPC services as MCP tools for AI agents.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/UFO-Tech/mcp-bundle",
    "require": {
        "php": ">=8.4",
        "mcp/sdk": "^0.8.1",
        "ufo-tech/json-rpc-bundle": "^10.4.3",
        "symfony/psr-http-message-bridge": "^7.2 || ^8.0",
        "symfony/yaml": "^7.2 || ^8.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {"psr-4": {"Ufo\\McpBundle\\": "src/"}},
    "autoload-dev": {"psr-4": {"Ufo\\McpBundle\\Tests\\": "tests/"}},
    "authors": [
        {
            "name": "Alex Maistrenko",
            "email": "ashterix69@gmail.com"
        }
    ],
    "prefer-stable": true,
    "keywords": [
        "rpc",
        "mcp",
        "ai",
        "agent",
        "transport",
        "adapter",
        "ufo-tech"
    ],
    "scripts": {"test": "phpunit"},
    "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": false}}
}
